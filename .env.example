# Database
DATABASE_URL=postgresql://username:password@localhost:5432/aituber

# Qwen TTS API
TTS_BASE_URL=http://localhost:7865
# Mode: voice_clone / custom_voice / voice_design
TTS_DEFAULT_MODE=custom_voice
# Default speaker (for custom_voice)
TTS_DEFAULT_SPEAKER=ono_anna
# TTS language
TTS_DEFAULT_LANGUAGE=japanese
# Default instruct (empty = disabled)
TTS_DEFAULT_INSTRUCT=

# LLM API
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL_NAME=gpt-4-turbo

# Storage
MEDIA_ROOT=/var/aituber/media

# Logging
LOG_LEVEL=INFO

# Processing
SEGMENT_DURATION=5
EVENT_GROUPING_WINDOW=3
COMPOSE_OVERLAP_MIN_GAP_SECONDS=0.0
COMPOSE_OVERLAP_STRATEGY=clip_previous
COMPOSE_CLIP_MIN_KEEP_SECONDS=0.3
